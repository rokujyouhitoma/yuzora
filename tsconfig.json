{
  "compilerOptions": {
    "target": "es2022",
    "module": "es6",
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": ["src/js/**/*"]
}
